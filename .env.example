# Copy to .env and set a real password. .env is not committed.
LORE_ADMIN_PASSWORD=change-me
# Family members, comma separated. Used only to seed a new database.
LORE_FAMILY=Parent 1, Parent 2, Child
# Host folder for media. Must be outside the container.
LORE_DATA=G:/lore
# Local time zone: video timestamps (UTC) are converted to it so they sort with photo EXIF times.
TZ=Asia/Singapore
