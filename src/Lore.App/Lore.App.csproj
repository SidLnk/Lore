<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>Lore.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Lore</ApplicationTitle>
		<ApplicationId>arpa.home.lore</ApplicationId>
		<ApplicationDisplayVersion>1.2</ApplicationDisplayVersion>
		<ApplicationVersion>3</ApplicationVersion>

		<SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- Release: an APK to sideload onto the family's phones. The key lives outside the repo (see README);
	     every update must be signed with it or Android refuses to install over the old version. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<AndroidPackageFormats>apk</AndroidPackageFormats>
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(USERPROFILE)\.lore\lore-release.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>lore</AndroidSigningKeyAlias>
		<AndroidSigningStorePass>file:$(USERPROFILE)\.lore\keystore-password.txt</AndroidSigningStorePass>
		<AndroidSigningKeyPass>file:$(USERPROFILE)\.lore\keystore-password.txt</AndroidSigningKeyPass>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2B4C3F" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2B4C3F" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Lore.Client\Lore.Client.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

</Project>
