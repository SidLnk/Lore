<?xml version="1.0" encoding="UTF-8" ?>
<Shell
	x:Class="Lore.App.AppShell"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:pages="clr-namespace:Lore.App.Pages"
	Shell.FlyoutBehavior="Disabled"
	FlyoutWidth="80"
	FlyoutVerticalScrollMode="Disabled"
	Title="Lore">

	<!-- Rail icons aren't tinted, so each tab ships a dark-theme variant (the bottom bar tints either one).
	     Phones: bottom tabs. Windows 600dp and wider: the same destinations as a navigation rail (a locked, narrow flyout). -->
	<Shell.FlyoutHeader>
		<Image
			Source="{AppThemeBinding Light=lore_symbol.png, Dark=lore_symbol_dark.png}"
			WidthRequest="32" HeightRequest="32" Margin="0,20,0,24" SemanticProperties.Description="Lore" />
	</Shell.FlyoutHeader>

	<Shell.ItemTemplate>
		<DataTemplate x:DataType="BaseShellItem">
			<VerticalStackLayout Padding="0,4,0,12" Spacing="4" SemanticProperties.Description="{Binding Title}">
				<Border WidthRequest="56" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 16" HorizontalOptions="Center">
					<Border.Triggers>
						<DataTrigger TargetType="Border" Binding="{Binding IsChecked}" Value="True">
							<Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Primary}}" />
						</DataTrigger>
					</Border.Triggers>
					<Image Source="{Binding Icon}" WidthRequest="24" HeightRequest="24" />
				</Border>
				<!-- Fixed size like the bottom tab labels (Platforms/Android/Resources/values/dimens.xml). -->
				<Label Text="{Binding Title}" FontSize="13" FontAutoScalingEnabled="False" HorizontalTextAlignment="Center">
					<Label.Triggers>
						<DataTrigger TargetType="Label" Binding="{Binding IsChecked}" Value="True">
							<Setter Property="FontFamily" Value="OpenSansSemibold" />
						</DataTrigger>
					</Label.Triggers>
				</Label>
			</VerticalStackLayout>
		</DataTemplate>
	</Shell.ItemTemplate>

	<FlyoutItem FlyoutDisplayOptions="AsMultipleItems">
		<ShellContent Title="Home" Icon="{AppThemeBinding Light=tab_home.png, Dark=tab_home_dark.png}" ContentTemplate="{DataTemplate pages:HomePage}" Route="home" />
		<ShellContent Title="Library" Icon="{AppThemeBinding Light=tab_library.png, Dark=tab_library_dark.png}" ContentTemplate="{DataTemplate pages:LibraryPage}" Route="library" />
		<ShellContent Title="Upload" Icon="{AppThemeBinding Light=tab_upload.png, Dark=tab_upload_dark.png}" ContentTemplate="{DataTemplate pages:UploadPage}" Route="upload" />
		<ShellContent Title="Places" Icon="{AppThemeBinding Light=tab_map.png, Dark=tab_map_dark.png}" ContentTemplate="{DataTemplate pages:PlacesPage}" Route="places" />
		<ShellContent Title="Family" Icon="{AppThemeBinding Light=tab_family.png, Dark=tab_family_dark.png}" ContentTemplate="{DataTemplate pages:FamilyPage}" Route="family" />
	</FlyoutItem>

</Shell>
