<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="Lore.App.Pages.PairingPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	Title="Pair this phone">

	<ScrollView>
		<VerticalStackLayout Padding="24" Spacing="16">
			<Image Source="{AppThemeBinding Light=lore_logo.png, Dark=lore_logo_dark.png}" HeightRequest="40"
				HorizontalOptions="Start" SemanticProperties.Description="Lore" />
			<!-- The address gets its own line: wrapped inside the sentence it broke mid-domain at large text sizes. -->
			<VerticalStackLayout Spacing="2">
				<Label Text="On the home PC, open" />
				<Label Text="http://lore.home.arpa/admin" FontFamily="OpenSansSemibold" FontSize="16" />
				<Label Text="and tap New pairing code. Enter the code below." />
			</VerticalStackLayout>

			<VerticalStackLayout x:Name="PairForm" Spacing="8">
				<Label Text="Server" />
				<Entry x:Name="ServerEntry" Text="lore.home.arpa" Keyboard="Url" />
				<Label Text="Pairing code" />
				<Entry x:Name="CodeEntry" Keyboard="Numeric" MaxLength="6" Placeholder="6 digits" />
				<Label Text="Phone name" />
				<Entry x:Name="NameEntry" />
				<Button x:Name="PairButton" Text="Pair" Clicked="OnPair" Margin="0,8,0,0" />
			</VerticalStackLayout>

			<VerticalStackLayout x:Name="OwnerForm" Spacing="8" IsVisible="False">
				<Label Text="Whose phone is this?" FontSize="20" />
				<Label Text="New uploads belong to this person unless you choose someone else." />
				<VerticalStackLayout x:Name="OwnerButtons" Spacing="8" />
			</VerticalStackLayout>

			<ActivityIndicator x:Name="Busy" IsRunning="False" />
			<Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" />
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
