<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="Lore.App.Pages.UploadPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:pages="clr-namespace:Lore.App.Pages"
	x:DataType="pages:UploadViewModel"
	Title="Upload">

	<Grid RowDefinitions="Auto,Auto,Auto,*" Padding="12" RowSpacing="10">
		<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
			<Label Text="Belongs to" VerticalOptions="Center" />
			<Picker Grid.Column="1" ItemsSource="{Binding Owners}" SelectedItem="{Binding SelectedOwner}" Title="Owner" />
		</Grid>
		<Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
			<Button Text="Choose photos &amp; videos" Command="{Binding ChooseFromPhoneCommand}" />
			<Button Grid.Column="1" Text="System picker" Command="{Binding SystemPickerCommand}" />
		</Grid>
		<Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
			<Label Text="{Binding Summary}" VerticalOptions="Center" />
			<Button Grid.Column="1" Text="Retry failed" Command="{Binding RetryFailedCommand}" IsVisible="{Binding HasFailed}" />
			<Button Grid.Column="2" Text="Clear done" Command="{Binding ClearDoneCommand}" />
		</Grid>
		<CollectionView Grid.Row="3" ItemsSource="{Binding Rows}">
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="pages:QueueRow">
					<VerticalStackLayout Padding="0,6" Spacing="2">
						<Label Text="{Binding Name}" LineBreakMode="MiddleTruncation" />
						<ProgressBar Progress="{Binding Progress}" />
						<Label Text="{Binding Detail}" FontSize="12" Opacity="0.7">
							<Label.Triggers>
								<DataTrigger TargetType="Label" Binding="{Binding IsFailed}" Value="True">
									<Setter Property="TextColor" Value="Red" />
									<Setter Property="Opacity" Value="1" />
								</DataTrigger>
							</Label.Triggers>
						</Label>
					</VerticalStackLayout>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
	</Grid>
</ContentPage>
