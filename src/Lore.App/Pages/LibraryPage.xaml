<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="Lore.App.Pages.LibraryPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:pages="clr-namespace:Lore.App.Pages"
	x:Name="Root"
	x:DataType="pages:LibraryViewModel"
	Title="Library">

	<Grid RowDefinitions="Auto,Auto,*">
		<!-- One scrolling row of filter chips. "Clear all" leads once anything is set, so it is never scrolled out of reach. -->
		<ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="{Binding ShowFilters}">
			<HorizontalStackLayout Spacing="8" Padding="12,0">
				<Button Margin="-8,0,0,0" Text="Clear all" Style="{StaticResource TextButton}" IsVisible="{Binding AnyActive}" Command="{Binding ClearFiltersCommand}" />
				<pages:Chip Text="{Binding AreaLabel}" IsActive="True" Trailing="Close" IsVisible="{Binding HasArea}" Command="{Binding ClearAreaCommand}" />
				<pages:Chip Text="{Binding OwnerChip}" IsActive="{Binding OwnerActive}" Trailing="Chevron" Command="{Binding PickOwnerCommand}" />
				<pages:Chip Text="{Binding TypeChip}" IsActive="{Binding TypeActive}" Trailing="Chevron" Command="{Binding PickTypeCommand}" />
				<pages:Chip Text="{Binding DateChip}" IsActive="{Binding UseDateRange}" Trailing="Chevron" Command="{Binding PickDatesCommand}" />
				<pages:Chip Text="Favorites" IsActive="{Binding FavoritesOnly}" Command="{Binding ToggleFavoritesCommand}" />
				<pages:Chip Text="{Binding AlbumChip}" IsActive="{Binding AlbumActive}" Trailing="Chevron" Command="{Binding PickAlbumCommand}" />
				<pages:Chip Text="{Binding FolderChip}" IsActive="{Binding FolderActive}" Trailing="Chevron" Command="{Binding PickFolderCommand}" />
				<pages:Chip Text="{Binding TagChip}" IsActive="{Binding TagActive}" Trailing="Chevron" Command="{Binding PickTagCommand}" />
				<pages:Chip Text="{Binding LocationChip}" IsActive="{Binding LocationActive}" Trailing="Chevron" Command="{Binding PickLocationCommand}" />
				<pages:Chip Text="{Binding DeviceChip}" IsActive="{Binding DeviceActive}" Trailing="Chevron" Command="{Binding PickDeviceCommand}" />
			</HorizontalStackLayout>
		</ScrollView>

		<HorizontalStackLayout Grid.Row="1" Spacing="8" Padding="16,0,16,4" IsVisible="{Binding ShowCustomDates}">
			<DatePicker Date="{Binding FromDate}" />
			<Label Text="to" VerticalOptions="Center" />
			<DatePicker Date="{Binding ToDate}" />
		</HorizontalStackLayout>

		<RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding ReloadCommand}">
			<CollectionView
				x:Name="Media"
				ItemsSource="{Binding Groups}"
				IsGrouped="True"
				RemainingItemsThreshold="30"
				RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
				<CollectionView.EmptyView>
					<Label Text="{Binding Message}" HorizontalTextAlignment="Center" Margin="32,48" />
				</CollectionView.EmptyView>
				<CollectionView.ItemsLayout>
					<GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="2" VerticalItemSpacing="2" />
				</CollectionView.ItemsLayout>
				<CollectionView.GroupHeaderTemplate>
					<DataTemplate x:DataType="pages:MonthGroup">
						<Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="16" Padding="8,16,8,6" />
					</DataTemplate>
				</CollectionView.GroupHeaderTemplate>
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="pages:MediaItem">
						<!-- Selected: the photo insets onto a tonal tile and gets a drawn check, so it stays visible. -->
						<pages:SquareGrid BackgroundColor="{AppThemeBinding Light=#E6E6E6, Dark=#2A2A2A}">
							<Grid.Triggers>
								<DataTrigger TargetType="pages:SquareGrid" Binding="{Binding IsSelected}" Value="True">
									<Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}" />
								</DataTrigger>
							</Grid.Triggers>
							<Grid.GestureRecognizers>
								<TapGestureRecognizer
									Command="{Binding Vm.OpenCommand, Source={x:Reference Root}, x:DataType=pages:LibraryPage}"
									CommandParameter="{Binding .}" />
							</Grid.GestureRecognizers>
							<Image Source="{Binding ThumbUrl}" Aspect="AspectFill">
								<Image.Triggers>
									<DataTrigger TargetType="Image" Binding="{Binding IsSelected}" Value="True">
										<Setter Property="Margin" Value="12" />
									</DataTrigger>
								</Image.Triggers>
							</Image>
							<HorizontalStackLayout
								IsVisible="{Binding IsVideo}" Spacing="4" Padding="6,3" Margin="4"
								BackgroundColor="#80000000" HorizontalOptions="End" VerticalOptions="End">
								<Path Data="M0,0 L7,4.5 L0,9 Z" Fill="White" WidthRequest="7" HeightRequest="9" VerticalOptions="Center" />
								<Label Text="{Binding DurationText}" IsVisible="{Binding HasDuration}" TextColor="White" FontSize="12" VerticalOptions="Center" />
							</HorizontalStackLayout>
							<Grid WidthRequest="24" HeightRequest="24" Margin="6" HorizontalOptions="Start" VerticalOptions="Start" IsVisible="{Binding IsSelecting}">
								<Ellipse Stroke="White" StrokeThickness="2" Fill="#33000000" />
								<Grid IsVisible="{Binding IsSelected}">
									<Ellipse Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" Stroke="White" StrokeThickness="2" />
									<Path Data="M7,12.5 L10.5,16 L17,9" Stroke="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}" StrokeThickness="2.25"
										StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="None" />
								</Grid>
							</Grid>
						</pages:SquareGrid>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</RefreshView>
	</Grid>
</ContentPage>
